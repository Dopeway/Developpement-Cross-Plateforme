rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(id) { return signedIn() && request.auth.uid == id; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    function hasSupportedArtisanCatalog() {
      return request.resource.data.trade in [
        'plumber', 'electrician', 'air_conditioning_technician',
        'appliance_repairer', 'locksmith', 'painter', 'carpenter'
      ] && request.resource.data.area in [
        'tunis', 'ariana', 'ben_arous', 'manouba', 'sfax', 'sousse', 'bizerte'
      ];
    }
    // Firestore can prove these equalities from the client query constraints.
    function isParticipant() { return signedIn() && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.artisanId); }
    function changesOnlyWorkflowFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'quoteAmount', 'interventionReport']);
    }
    function quoteIsUnchanged() {
      return request.resource.data.quoteAmount == resource.data.quoteAmount;
    }
    function isArtisanForRequest() { return signedIn() && request.auth.uid == resource.data.artisanId; }
    function isClientForRequest() { return signedIn() && request.auth.uid == resource.data.clientId; }
    function artisanWorkflowChange() {
      return isArtisanForRequest() && (
        (resource.data.status == 'pending'
          && request.resource.data.status in ['awaitingQuote', 'refused'])
        || (resource.data.status in ['accepted', 'quoteAccepted']
          && request.resource.data.status == 'inProgress')
      ) && (request.resource.data.status == 'awaitingQuote'
        ? (request.resource.data.quoteAmount is int
          && request.resource.data.quoteAmount >= 0)
        : quoteIsUnchanged());
    }
    function artisanReportChange() {
      return isArtisanForRequest()
        && resource.data.status == 'inProgress'
        && request.resource.data.status == 'inProgress'
        && quoteIsUnchanged();
    }
    function artisanCompletionWithReport() {
      return isArtisanForRequest()
        && resource.data.status == 'inProgress'
        && request.resource.data.status == 'completed'
        && quoteIsUnchanged()
        && request.resource.data.interventionReport.workPerformed is string
        && request.resource.data.interventionReport.workPerformed.size() >= 10;
    }
    function clientWorkflowChange() {
      return isClientForRequest() && (
        (resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'awaitingQuote'
          && request.resource.data.status in ['accepted', 'quoteRefused'])
      ) && quoteIsUnchanged();
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role in ['client', 'artisan'] && request.resource.data.keys().hasOnly(['name', 'email', 'role']);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) || isAdmin();
      allow delete: if isAdmin();
      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['value', 'createdAt']) && request.resource.data.value is string && request.resource.data.value.size() >= 5 && request.resource.data.value.size() <= 200 && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    match /artisans/{artisanId} {
      allow read: if signedIn() && (resource.data.verified == true || isOwner(artisanId) || isAdmin());
      allow create: if isAdmin() || (isOwner(artisanId) && hasSupportedArtisanCatalog() && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artisan');
      allow update: if isAdmin() || (isOwner(artisanId) && hasSupportedArtisanCatalog() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'trade', 'area', 'startingPrice', 'availableToday', 'availabilityRules', 'availabilityExceptions', 'defaultDurationMinutes']));
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isParticipant() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly([
          'service', 'artisanId', 'artisanName', 'clientId', 'clientName',
          'description', 'address', 'date', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'service', 'artisanId', 'artisanName', 'clientId', 'clientName',
          'description', 'address', 'date', 'status', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.address in [
          'Tunis', 'Ariana', 'Ben Arous', 'Manouba', 'Sfax', 'Sousse', 'Bizerte'
        ]
        && existsAfter(/databases/$(database)/documents/requests/$(requestId)/private/location);
      allow update: if isAdmin() || (
        changesOnlyWorkflowFields()
        && (artisanWorkflowChange() || clientWorkflowChange() || artisanReportChange() || artisanCompletionWithReport())
      );
      allow delete: if isAdmin();
      match /private/{document} {
        allow create: if document == 'location'
          && signedIn()
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.clientId == request.auth.uid
          && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.status == 'pending'
          && request.resource.data.keys().hasOnly(['address'])
          && request.resource.data.address is string
          && request.resource.data.address.size() >= 5
          && request.resource.data.address.size() <= 200;
        allow read: if isAdmin()
          || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.clientId)
          || (signedIn()
            && request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.artisanId
            && get(/databases/$(database)/documents/requests/$(requestId)).data.status in ['accepted', 'quoteAccepted', 'inProgress', 'completed']);
        allow update, delete: if false;
      }
      match /billing/{documentId} {
        function sourceRequest() {
          return get(/databases/$(database)/documents/requests/$(requestId)).data;
        }
        allow read: if signedIn()
          && (request.auth.uid == sourceRequest().clientId
            || request.auth.uid == sourceRequest().artisanId);
        allow create: if documentId == 'document'
          && signedIn()
          && request.auth.uid == sourceRequest().artisanId
          && sourceRequest().status == 'completed'
          && sourceRequest().quoteAmount is int
          && sourceRequest().interventionReport.workPerformed is string
          && request.resource.data.keys().hasOnly([
            'requestId', 'artisanId', 'clientId', 'issuerName',
            'issuerAddress', 'taxId', 'vatRate', 'clientName',
            'clientAddress', 'service', 'workPerformed', 'serviceDate',
            'diagnosis', 'materials', 'clientAdvice',
            'totalMillimes', 'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'requestId', 'artisanId', 'clientId', 'issuerName',
            'issuerAddress', 'taxId', 'vatRate', 'clientName',
            'clientAddress', 'service', 'workPerformed', 'serviceDate',
            'diagnosis', 'materials', 'clientAdvice',
            'totalMillimes', 'createdAt'
          ])
          && request.resource.data.requestId == requestId
          && request.resource.data.artisanId == sourceRequest().artisanId
          && request.resource.data.clientId == sourceRequest().clientId
          && request.resource.data.clientName == sourceRequest().clientName
          && request.resource.data.clientAddress == (
            exists(/databases/$(database)/documents/requests/$(requestId)/private/location)
              ? get(/databases/$(database)/documents/requests/$(requestId)/private/location).data.address
              : sourceRequest().address
          )
          && request.resource.data['service'] == sourceRequest()['service']
          && request.resource.data.workPerformed == sourceRequest().interventionReport.workPerformed
          && request.resource.data.serviceDate == sourceRequest().date
          && request.resource.data.diagnosis == sourceRequest().interventionReport.get('diagnosis', '')
          && request.resource.data.materials == sourceRequest().interventionReport.get('materials', '')
          && request.resource.data.clientAdvice == sourceRequest().interventionReport.get('clientAdvice', '')
          && request.resource.data.totalMillimes == sourceRequest().quoteAmount * 1000
          && request.resource.data.issuerName is string
          && request.resource.data.issuerName.size() >= 2
          && request.resource.data.issuerName.size() <= 120
          && request.resource.data.issuerAddress is string
          && request.resource.data.issuerAddress.size() >= 5
          && request.resource.data.issuerAddress.size() <= 200
          && request.resource.data.taxId is string
          && request.resource.data.taxId.size() >= 1
          && request.resource.data.taxId.size() <= 32
          && request.resource.data.vatRate is int
          && request.resource.data.vatRate >= 0
          && request.resource.data.vatRate <= 100
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isParticipant() && get(/databases/$(database)/documents/requests/$(requestId)).data.status in ['accepted', 'awaitingQuote', 'quoteAccepted', 'inProgress'];
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && reviewId == request.resource.data.requestId && request.resource.data.clientId == request.auth.uid && get(/databases/$(database)/documents/requests/$(reviewId)).data.clientId == request.auth.uid && get(/databases/$(database)/documents/requests/$(reviewId)).data.status == 'completed';
      allow update, delete: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId) || isAdmin();
      allow update: if isOwner(resource.data.recipientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow create, delete: if false;
    }
  }
}
