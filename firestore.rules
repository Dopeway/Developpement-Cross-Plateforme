rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(id) { return signedIn() && request.auth.uid == id; }
    function isAdmin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    // Firestore can prove these equalities from the client query constraints.
    function isParticipant() { return signedIn() && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.artisanId); }
    function changesOnlyStatusAndQuote() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'quoteAmount']);
    }
    function quoteIsUnchanged() {
      return request.resource.data.quoteAmount == resource.data.quoteAmount;
    }
    function isArtisanForRequest() { return signedIn() && request.auth.uid == resource.data.artisanId; }
    function isClientForRequest() { return signedIn() && request.auth.uid == resource.data.clientId; }
    function artisanWorkflowChange() {
      return isArtisanForRequest() && (
        (resource.data.status == 'pending'
          && request.resource.data.status in ['awaitingQuote', 'refused'])
        || (resource.data.status in ['accepted', 'quoteAccepted']
          && request.resource.data.status == 'inProgress')
        || (resource.data.status == 'inProgress'
          && request.resource.data.status == 'completed')
      ) && (request.resource.data.status == 'awaitingQuote'
        ? (request.resource.data.quoteAmount is int
          && request.resource.data.quoteAmount >= 0)
        : quoteIsUnchanged());
    }
    function clientWorkflowChange() {
      return isClientForRequest() && (
        (resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'awaitingQuote'
          && request.resource.data.status in ['accepted', 'quoteRefused'])
      ) && quoteIsUnchanged();
    }

    match /users/{userId} {
      allow create: if isOwner(userId) && request.resource.data.role in ['client', 'artisan'] && request.resource.data.keys().hasOnly(['name', 'email', 'role']);
      allow read: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])) || isAdmin();
      allow delete: if isAdmin();
      match /addresses/{addressId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['value', 'createdAt']) && request.resource.data.value is string && request.resource.data.value.size() >= 5 && request.resource.data.value.size() <= 200 && request.resource.data.createdAt == request.time;
        allow update: if false;
      }
    }

    match /artisans/{artisanId} {
      allow read: if signedIn() && (resource.data.verified == true || isOwner(artisanId) || isAdmin());
      allow create: if isAdmin() || (isOwner(artisanId) && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'artisan');
      allow update: if isAdmin() || (isOwner(artisanId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'trade', 'area', 'startingPrice', 'availableToday', 'availabilityRules', 'availabilityExceptions', 'defaultDurationMinutes']));
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isParticipant() || isAdmin();
      allow create: if signedIn()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        changesOnlyStatusAndQuote()
        && (artisanWorkflowChange() || clientWorkflowChange())
      );
      allow delete: if isAdmin();
      match /private/{document} {
        allow read: if isAdmin()
          || (signedIn() && request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.clientId)
          || (signedIn()
            && request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.artisanId
            && get(/databases/$(database)/documents/requests/$(requestId)).data.status in ['accepted', 'awaitingQuote', 'quoteAccepted', 'inProgress', 'completed']);
      }
      match /messages/{messageId} {
        allow read: if isParticipant() && get(/databases/$(database)/documents/requests/$(requestId)).data.status in ['accepted', 'awaitingQuote', 'quoteAccepted', 'inProgress'];
        allow create: if isParticipant() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn() && reviewId == request.resource.data.requestId && request.resource.data.clientId == request.auth.uid && get(/databases/$(database)/documents/requests/$(reviewId)).data.clientId == request.auth.uid && get(/databases/$(database)/documents/requests/$(reviewId)).data.status == 'completed';
      allow update, delete: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientId) || isAdmin();
      allow update: if isOwner(resource.data.recipientId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow create, delete: if false;
    }
  }
}
